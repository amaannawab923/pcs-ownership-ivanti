# Rendered by superset_ownership.model.render_dsl(MODEL) -- do not hand-edit;
# a test pins the two equal. See model/__init__.py for the JSON source of
# truth and superset ownership fga install-model to write it to a store.

model
  schema 1.1

type user

type tenant
  relations
    define member: [user]
    define admin: [user, group#member]

type group
  relations
    define member: [user, group#member]
    define tenant: [tenant#member]

type dashboard
  relations
    define owner: [user]
    define editor: [user, group#member] or owner
    define viewer: [user, group#member] or editor
    define tenant: [tenant#member]

type chart
  relations
    define owner: [user]
    define editor: [user, group#member] or owner
    define viewer: [user, group#member] or editor
    define tenant: [tenant#member]
